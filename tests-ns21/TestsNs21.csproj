<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- THE UNITY-CLASS GATE: this runner consumes the netstandard2.1 build
         of the library — the exact assembly surface a Unity project gets —
         and runs the full suite, the 128 bit tests included: that surface
         speaks the emulated pair and exists on every TFM. The golden wire
         test inside proves the 2.1 compat shims byte-neutral. The only tests
         missing are the two System.Int128 oracle cross-checks below. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Serialize.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- no SERIALIZE_HAS_INT128: the define gates only the System.Int128 ORACLE tests; the 2.1 assembly carries the full 128 surface on the emulated pair -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../tests/*.cs" />
    <ProjectReference Include="../src/Serialize.csproj" SetTargetFramework="TargetFramework=netstandard2.1" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- family value: zero third-party dependencies, including test frameworks. -->

</Project>
