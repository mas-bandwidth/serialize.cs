<?xml version="1.0" encoding="utf-8"?>
<!-- The fuzz harness is the only project with a package reference (SharpFuzz). Its
     one source is nuget.org, stated here so a machine-wide NuGet configuration
     cannot change where it comes from; packages.lock.json pins the bytes. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
