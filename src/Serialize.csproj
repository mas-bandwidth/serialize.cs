<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 (LTS) is the floor so game servers on .NET 8 can reference the
         library; net10.0 is the current SDK. netstandard2.1 is the Unity-class
         target (Unity 2021+ through Unity 6: C# 9, netstandard2.1 API surface) —
         LangVersion pins it to C# 9 so anything Unity's compiler would refuse
         fails HERE, in CI, not in the editor. The FULL surface — including the
         128 bit paths — runs on every TFM: Int128Value/UInt128Value (the
         emulated pair, Int128Pair.cs) carry the 128 bit API everywhere, with
         implicit System.Int128 conversions on .NET 7+. One code path per
         operation on every TFM — the compat shims at the bottom of
         Serialize.cs are unconditional except LeadingZeroCount, so wire
         behavior cannot diverge by framework. -->
    <TargetFrameworks>net8.0;net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'netstandard2.1'">9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ARITHMETIC DISCIPLINE. STANDARD.md: a trap, a crash or an abort on malformed
       input is non-conforming, and this port's failure idiom is a return code plus a
       latched error. C# arithmetic in a checked context THROWS on overflow and on an
       out of range conversion, and the wire arithmetic is two's complement by design:
       a ranged read subtracts bounds in the unsigned domain, the bit window narrows a
       64 bit load to 32 bits, and a fixed point read reinterprets an offset at the
       storage width. Every such site carries an explicit `unchecked`, so the reader
       cannot be made to throw by any input, and this property states the shipped
       default rather than inheriting it from whatever a consuming build sets.

       SerializeCheckedArithmeticProbe=true compiles this library — and only this
       library, the test projects keep the default — with the checked context turned
       on, which turns every unannotated wire arithmetic site into an exception the
       suite reports. The ci workflow runs it. It is a gate, never a shipping
       configuration: a released assembly that throws on a wrapping read would be the
       defect the annotations exist to prevent. -->
  <PropertyGroup>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <CheckForOverflowUnderflow Condition="'$(SerializeCheckedArithmeticProbe)' == 'true'">true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <!-- NEGATIVE CONTROLS. STANDARD.md: for each refusal rule, a reader with that one
       rule deleted, run against the real corpus, must fail exactly the vectors its
       conformance-controls/<rule>.expected names. SerializeConformanceControls=true
       compiles the switch that deletes one rule at a time (SerializeConformanceControls
       in Serialize.cs) into this library and the test projects, which then run every
       control. The ci workflow runs it. It is a gate, never a shipping configuration:
       without it the switch is a constant the JIT folds away. -->
  <PropertyGroup Condition="'$(SerializeConformanceControls)' == 'true'">
    <DefineConstants>$(DefineConstants);SERIALIZE_CONFORMANCE_CONTROLS</DefineConstants>
  </PropertyGroup>

  <!-- THE FUZZER'S NEGATIVE CONTROL. SerializeFuzzSabotage=true plants a write/read
       asymmetry in WriteStream.SerializeUInt16 (SERIALIZE_FUZZ_SABOTAGE in
       Serialize.cs), so the coverage-guided fuzzer (fuzz/, scripts/fuzz.sh) is seen to
       go red on a real asymmetry: the ci workflow's fuzz job requires the sabotaged
       build to be caught inside the 60 s smoke budget, for that reason. It is a gate,
       never a shipping configuration: without it the branch does not exist. -->
  <PropertyGroup Condition="'$(SerializeFuzzSabotage)' == 'true'">
    <DefineConstants>$(DefineConstants);SERIALIZE_FUZZ_SABOTAGE</DefineConstants>
  </PropertyGroup>

  <!-- Version and package identity. Version travels with the tag: a release is
       tagged vX.Y.Z and this property carries the same X.Y.Z, so the assembly a
       user has in hand can be traced back to a commit. The package metadata is
       here ahead of any NuGet push so the two cannot drift apart later. -->
  <PropertyGroup>
    <Version>2.0.1</Version>
    <PackageId>MasBandwidth.Serialize</PackageId>
    <Authors>Mas Bandwidth LLC</Authors>
    <Description>C# bitpacking serialization library, wire compatible with the C, C++, Go and Rust serialize libraries. Zero dependencies, zero allocation on the serialization path, and reads that fail cleanly on hostile input.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mas-bandwidth/serialize.cs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mas-bandwidth/serialize.cs</RepositoryUrl>
    <PackageTags>serialization;bitpacking;networking;gamedev;unity</PackageTags>
  </PropertyGroup>

  <!-- family value: zero third-party dependencies. no package references, ever. -->

</Project>
