<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 (LTS) is the floor so game servers on .NET 8 can reference the
         library; net10.0 is the current SDK. netstandard2.1 is the Unity-class
         target (Unity 2021+ through Unity 6: C# 9, netstandard2.1 API surface) —
         LangVersion pins it to C# 9 so anything Unity's compiler would refuse
         fails HERE, in CI, not in the editor. The 128 bit surface is gated to
         NET7_0_OR_GREATER (no Int128 on Unity-class runtimes); everything else
         runs the same single code path on every TFM — the compat shims at the
         bottom of Serialize.cs are unconditional except LeadingZeroCount, so
         wire behavior cannot diverge by framework. -->
    <TargetFrameworks>net8.0;net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion Condition="'$(TargetFramework)' == 'netstandard2.1'">9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- family value: zero third-party dependencies. no package references, ever. -->

</Project>
