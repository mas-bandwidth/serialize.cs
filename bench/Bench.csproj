<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- both runnable library TFMs, like the test runner: -f net8.0 / -f net10.0 -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Serialize.Bench</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- tiered compilation stays at the DEFAULT setting, unlike the test runner:
         the bench measures the codegen shipping code runs, and every timed closure
         takes one full untimed warmup pass first so the optimizing tier is what the
         trials see. (The test runner disables tiering for a different reason: its
         rarely-called conformance vectors would otherwise pin tier 0 code.) -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Serialize.csproj" />
  </ItemGroup>

  <!-- family value: zero third-party dependencies, including benchmark frameworks.
       this is a plain Stopwatch console runner; only Release numbers are meaningful
       (a double hyphen cannot appear in an XML comment, so: dotnet run, project
       bench/Bench.csproj, -c Release, -f net10.0) -->

</Project>
